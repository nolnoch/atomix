<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for atomix (applied to the main executable only when signing
  with a Developer ID; ad-hoc builds don't use the hardened runtime).
  QJSEngine (used to evaluate expressions in the UI) may JIT-compile JavaScript. Whether Qt's V4
  JIT maps its pages with MAP_JIT on every architecture isn't documented, so both JIT
  exceptions are granted. Both are accepted by notarization.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
